{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uigs.local/schemas/knowledge-change.schema.json",
  "title": "UIGS Knowledge Change Record",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "target_claim",
    "operation",
    "reason",
    "evidence_refs",
    "decided_by",
    "decided_at"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^CHANGE\\.[A-Za-z0-9._-]+$"
    },
    "target_claim": {
      "type": "string",
      "pattern": "^CLAIM\\.[A-Za-z0-9._-]+$"
    },
    "operation": {
      "enum": [
        "expand",
        "challenge",
        "quarantine",
        "revise",
        "contract",
        "restore",
        "demote",
        "deprecate",
        "supersede"
      ]
    },
    "from": {
      "type": "object",
      "properties": {
        "maturity": {
          "enum": [
            "observed",
            "candidate",
            "experimental",
            "validated",
            "canonical"
          ]
        },
        "authority": {
          "enum": [
            "active",
            "quarantined",
            "deprecated",
            "superseded"
          ]
        },
        "epistemic_state": {
          "enum": [
            "unknown",
            "supported",
            "mixed",
            "challenged",
            "contradicted",
            "stale"
          ]
        }
      },
      "additionalProperties": false
    },
    "to": {
      "type": "object",
      "properties": {
        "maturity": {
          "enum": [
            "observed",
            "candidate",
            "experimental",
            "validated",
            "canonical"
          ]
        },
        "authority": {
          "enum": [
            "active",
            "quarantined",
            "deprecated",
            "superseded"
          ]
        },
        "epistemic_state": {
          "enum": [
            "unknown",
            "supported",
            "mixed",
            "challenged",
            "contradicted",
            "stale"
          ]
        }
      },
      "additionalProperties": false
    },
    "reason": { "type": "string", "minLength": 1 },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^EVID\\.[A-Za-z0-9._-]+$"
      },
      "uniqueItems": true
    },
    "decided_by": {
      "enum": ["automation", "human_reviewer", "user", "governance"]
    },
    "decided_at": {
      "type": "string",
      "format": "date-time"
    },
    "reversible": {
      "type": "boolean",
      "default": true
    },
    "replacement_claim": {
      "type": ["string", "null"],
      "pattern": "^CLAIM\\.[A-Za-z0-9._-]+$"
    }
  },
  "additionalProperties": false
}
