{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uigs.local/schemas/triage-record.schema.json",
  "title": "UIGS Pending Triage Record",
  "type": "object",
  "required": [
    "schema_version",
    "packet_id",
    "source_repository",
    "packet_sha256",
    "triage_status",
    "record_type",
    "routing_hints",
    "related_records"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "packet_id": {
      "type": "string"
    },
    "source_repository": {
      "type": "string"
    },
    "packet_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "triage_status": {
      "enum": [
        "needs-review",
        "ready-for-record",
        "auto-classified"
      ]
    },
    "record_type": {
      "type": "string"
    },
    "routing_hints": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "red_reason": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "category": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "needs_review": {
          "type": "boolean"
        },
        "signals": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "matched_rules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "related_records": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "created_at": {
      "type": "string"
    },
    "triaged_at": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
