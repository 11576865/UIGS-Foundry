{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uigs.local/schemas/project-ui-inventory.schema.json",
  "title": "UIGS Source-owned Project UI Surface Inventory",
  "type": "object",
  "required": [
    "schema_version",
    "project",
    "repository",
    "platform",
    "authority",
    "surface_count",
    "surfaces"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "string",
      "pattern": "^[^/]+/[^/]+$"
    },
    "platform": {
      "type": "string",
      "minLength": 1
    },
    "authority": {
      "type": "string",
      "minLength": 1
    },
    "surface_count": {
      "type": "integer",
      "minimum": 0
    },
    "surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "name",
          "status",
          "intent",
          "implementation_effect",
          "source_refs",
          "patterns",
          "visual_evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z0-9._-]+$"
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "group": {
            "type": "string"
          },
          "status": {
            "enum": [
              "implemented",
              "experimental",
              "deprecated",
              "planned"
            ]
          },
          "intent": {
            "type": "string"
          },
          "implementation_effect": {
            "type": "string"
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "path"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "anchor": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          },
          "patterns": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^UIGS\\."
            },
            "uniqueItems": true
          },
          "tests": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "visual_evidence": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object"
                }
              ]
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
