{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uigs.local/schemas/ui-production-visual-evidence.schema.json",
  "title": "UIGS Production Visual Evidence",
  "type": "object",
  "required": [
    "id",
    "record_type",
    "status",
    "evidence_level",
    "platform",
    "capture_id",
    "surface_ids",
    "entrypoint",
    "source_repository",
    "source_revision",
    "sha256",
    "image",
    "provenance"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^VISUAL\\.PRODUCTION\\."
    },
    "record_type": {
      "const": "ui-production-visual-evidence"
    },
    "status": {
      "enum": [
        "experimental",
        "validated",
        "superseded"
      ]
    },
    "evidence_level": {
      "enum": [
        "production-rendered",
        "runtime-backed",
        "field-capture"
      ]
    },
    "platform": {
      "type": "string"
    },
    "capture_id": {
      "type": "string"
    },
    "surface_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "patterns": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^UIGS\\."
      },
      "uniqueItems": true
    },
    "entrypoint": {
      "type": "string"
    },
    "source_repository": {
      "type": "string"
    },
    "source_revision": {
      "type": "string",
      "minLength": 7
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "image": {
      "type": "object",
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": true
    },
    "environment": {
      "type": "object"
    },
    "capture_contract": {
      "type": "object"
    },
    "change_status": {
      "enum": [
        "new",
        "unchanged",
        "changed"
      ]
    },
    "previous_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": true
}
