{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uigs.local/schemas/agent-task-state.schema.json",
  "title": "UIGS Durable Agent Task State",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "goal",
    "status",
    "current_work_unit",
    "completed_units",
    "next_units",
    "repository",
    "last_durable_commit",
    "external_validation",
    "blockers",
    "updated_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "planned",
        "in_progress",
        "blocked",
        "completed"
      ]
    },
    "current_work_unit": {
      "type": [
        "string",
        "null"
      ]
    },
    "completed_units": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "next_units": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "repository": {
      "type": "string",
      "pattern": "^[^/]+/[^/]+$"
    },
    "branch": {
      "type": [
        "string",
        "null"
      ]
    },
    "pull_request": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "last_durable_commit": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-fA-F]{7,40}$"
    },
    "external_validation": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "not_required",
          "pending",
          "passed",
          "failed",
          "blocked",
          "unknown"
        ]
      }
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
