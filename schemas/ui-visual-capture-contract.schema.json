{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uigs.local/schemas/ui-visual-capture-contract.schema.json",
  "title": "UIGS Source-owned UI Visual Capture Contract",
  "type": "object",
  "required": [
    "schema_version",
    "project",
    "repository",
    "platform",
    "captures"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "string",
      "pattern": "^[^/]+/[^/]+$"
    },
    "platform": {
      "type": "string",
      "minLength": 1
    },
    "captures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "surface_ids",
          "adapter",
          "evidence_level",
          "output_name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z0-9._-]+$"
          },
          "surface_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "adapter": {
            "enum": [
              "playwright-web",
              "android-emulator-screencap",
              "android-component-snapshot",
              "windows-runtime-web"
            ]
          },
          "evidence_level": {
            "enum": [
              "production-rendered",
              "runtime-backed",
              "field-capture"
            ]
          },
          "output_name": {
            "type": "string",
            "pattern": "\\.png$"
          },
          "route": {
            "type": "string"
          },
          "selector": {
            "type": "string"
          },
          "capture_region": {
            "enum": [
              "element",
              "viewport",
              "full-page"
            ]
          },
          "viewport": {
            "type": "object"
          },
          "device": {
            "type": "object"
          },
          "ready": {
            "type": "object"
          },
          "build": {
            "type": "object"
          },
          "package": {
            "type": "string"
          },
          "activity": {
            "type": "string"
          },
          "source_dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
