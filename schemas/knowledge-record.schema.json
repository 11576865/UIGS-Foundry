{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uigs.local/schemas/knowledge-record.schema.json",
  "title": "UIGS Knowledge Record",
  "type": "object",
  "required": [
    "id",
    "type",
    "status",
    "title",
    "summary",
    "provenance"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 3
    },
    "type": {
      "enum": [
        "observation",
        "candidate",
        "rule",
        "pattern",
        "case",
        "bug",
        "test",
        "lesson",
        "policy",
        "implementation_reference",
        "report"
      ]
    },
    "status": {
      "enum": [
        "observed",
        "candidate",
        "experimental",
        "validated",
        "canonical",
        "pending",
        "rejected",
        "deprecated"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_type",
          "source"
        ],
        "properties": {
          "source_type": {
            "enum": [
              "repository",
              "file",
              "commit",
              "pull_request",
              "issue",
              "conversation",
              "device_test",
              "web",
              "report",
              "manual_decision"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "revision": {
            "type": "string"
          },
          "evidence_level": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "created": {
      "type": "string"
    },
    "updated": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
