{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uigs.local/schemas/project-adapter.schema.json",
  "title": "UIGS Project Adapter Manifest",
  "type": "object",
  "required": [
    "schema_version",
    "project",
    "repository",
    "foundry",
    "execution_authority",
    "outbox",
    "auto_capture",
    "tracked_workflows",
    "routing_hints"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "string",
      "pattern": "^[^/]+/[^/]+$"
    },
    "foundry": {
      "const": "11576865/UIGS-Foundry"
    },
    "execution_authority": {
      "type": "string",
      "minLength": 1
    },
    "outbox": {
      "type": "object",
      "required": [
        "branch",
        "packet_path"
      ],
      "properties": {
        "branch": {
          "const": "uigs-outbox"
        },
        "packet_path": {
          "const": "packets/"
        }
      },
      "additionalProperties": true
    },
    "auto_capture": {
      "type": "object",
      "required": [
        "ci_failures",
        "manual_dispatch",
        "canonical_promotion"
      ],
      "properties": {
        "ci_failures": {
          "type": "boolean"
        },
        "manual_dispatch": {
          "type": "boolean"
        },
        "canonical_promotion": {
          "const": false
        }
      },
      "additionalProperties": true
    },
    "tracked_workflows": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "routing_hints": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": true
}
