{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uigs.local/schemas/ui-composition.schema.json",
  "title": "UIGS UI Composition Recipe",
  "type": "object",
  "required": [
    "id",
    "type",
    "status",
    "name",
    "intent",
    "patterns",
    "composition_contract",
    "provenance"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^UIGS\\.RECIPE\\."
    },
    "type": {
      "const": "composition"
    },
    "status": {
      "enum": [
        "candidate",
        "experimental",
        "validated",
        "deprecated"
      ]
    },
    "name": {
      "type": "object",
      "required": [
        "zh",
        "en"
      ],
      "properties": {
        "zh": {
          "type": "string"
        },
        "en": {
          "type": "string"
        }
      }
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "intent": {
      "type": "string"
    },
    "patterns": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "id",
          "role"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^UIGS\\."
          },
          "role": {
            "enum": [
              "required",
              "recommended",
              "optional"
            ]
          },
          "purpose": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "composition_contract": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "platform_realizations": {
      "type": "object"
    },
    "showcases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "validation": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": true
}
